# 复制为 .env 后按需修改。生产环境务必更换密钥与默认密码。
AUTH_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# PostgreSQL（推荐；对应 compose.yaml 中的开发库）
DATABASE_URL=postgresql+psycopg://elf:elf_dev_password@127.0.0.1:5432/elf_studio
# 零依赖 SQLite 备选：注释上一行并启用下一行
# DATABASE_URL=sqlite:///data/elf_studio.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 首次启动时创建；已存在同名用户时不会覆盖密码。
ADMIN_USERNAME=demo
ADMIN_PASSWORD=demo1234
ADMIN_DISPLAY_NAME=研究员
